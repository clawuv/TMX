{
  "name": "tmx",
  "version": "1.0.0",
  "private": true,
  "description": "TMX SSH client and local terminal",
  "license": "MIT",
  "author": "he2dou",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/patch-dev-app-name.mjs",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "pnpm pretest && playwright test",
    "typecheck": "tsc --noEmit",
    "rebuild:natives": "electron-rebuild -f -w node-pty,better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.3",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.47.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "zmodem.js": "^0.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "cpu-features",
      "node-pty",
      "ssh2"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.8"
  }
}
